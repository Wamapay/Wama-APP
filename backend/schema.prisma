// ============================================================
// PRISMA SCHEMA — BACKEND STAGE 4 (FINANCIAL ENGINE)
// ============================================================
// Originally scaffolded in Backend Stage 1 with STUB financial models
// (Transaction/Commission/Cashback/Reward/Withdrawal had only
// structural fields). Backend Stage 4 replaces those stubs with a real
// immutable ledger (Transaction), per-balance-type User fields
// (cashbackBalance/commissionBalance/rewardBalance), and full
// Reward/Withdrawal models — see each model's comment below and
// src/services/{ledger,cashback,commission,reward,withdrawal}.service.js.
//
// Run `npm run migrate` once DATABASE_URL is set to create/update the
// migration from this schema.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  USER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

// Order lifecycle. PAID is FINAL — a paid order is never refunded or
// cancelled (see order.service.js). CANCELLED only ever applies before a
// payment succeeds (e.g. an abandoned/failed checkout).
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Tracks the payment provider's verification independently of OrderStatus.
// An order only becomes PAID once paymentStatus is confirmed SUCCESSFUL by
// a trusted source (dev/test simulation in this stage, real Paystack
// verification in a later stage) — never merely because the client says so.
enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

// No quizzes, no assessments — see platform business rules (Backend Stage 3).
enum LessonType {
  VIDEO
  PDF
  AUDIO
  TEXT
  DOCUMENT
  IMAGE
  EXTERNAL_RESOURCE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
}

// Admin moderation only ever toggles visibility — it never silently
// rewrites a user's rating/title/comment. See review.service.js.
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

// Agent verification derives from successfulReferrals >= 20. Never set
// directly by user/agent-facing APIs — see agent.service.js.
enum VerificationStatus {
  NOT_VERIFIED
  VERIFIED
}

// Referral lifecycle. Only SUCCESSFUL referrals count toward the
// 20-referral verification threshold and commission (Backend Stage 4).
enum ReferralStatus {
  REGISTERED
  PENDING
  SUCCESSFUL
  FAILED
}

// ------------------------------------------------------------
// FINANCIAL ENGINE (Backend Stage 4)
// ------------------------------------------------------------

// Every financial event recorded on the immutable ledger (Transaction)
// has exactly one of these types. Do not add types beyond what the
// platform rules require (see ledger.service.js).
enum TransactionType {
  COURSE_PURCHASE
  CASHBACK
  COMMISSION
  REWARD
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  WITHDRAWAL_FEE
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

// The three independently-tracked balances. Never merged into one field —
// see User.cashbackBalance / commissionBalance / rewardBalance.
enum BalanceType {
  CASHBACK
  COMMISSION
  REWARD
}

// What a Transaction/Referral is ultimately traceable back to.
enum ReferenceType {
  ORDER
  REWARD
  WITHDRAWAL
}

enum RewardType {
  REFERRAL_MILESTONE
}

enum RewardStatus {
  SUCCESSFUL
  REVERSED
}

// Withdrawal lifecycle. COMPLETED and FAILED are terminal — see
// withdrawal.service.js for the allowed state transitions.
enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ------------------------------------------------------------
// PAYMENTS (Backend Stage 5 — Paystack integration)
// ------------------------------------------------------------
// One row per payment ATTEMPT against an Order — never a 1:1 with Order,
// since a failed/abandoned attempt must not block retrying the same
// (still-PENDING) order with a fresh Paystack reference. See
// payment.service.js "Payment Retry" and Order.paymentReference, which is
// always kept pointing at the most recent attempt for that order.
//
// This is independent of PaymentStatus (which belongs to Order and is
// only ever flipped to SUCCESSFUL by order.service.js's
// handleSuccessfulPurchase — never directly by the Paystack controller,
// see platform rule "No Duplicated Financial Logic").
enum PaymentProvider {
  PAYSTACK
}

enum PaymentGatewayStatus {
  INITIALIZED
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  provider PaymentProvider @default(PAYSTACK)
  // The Paystack transaction reference — globally unique, generated by
  // us at initialize time (see utils/financeIdGenerator.js).
  providerReference String  @unique
  // Server-calculated at initialize time from Order.amount/currency —
  // NEVER the frontend-provided amount. See payment.service.js.
  amount   Decimal @db.Decimal(12, 2)
  currency String

  status          PaymentGatewayStatus @default(INITIALIZED)
  channel         String?
  gatewayResponse String?
  // Raw provider metadata useful for support/audit (e.g. gateway ids) —
  // never the Paystack secret key or any other credential.
  metadata Json?

  paidAt     DateTime?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ------------------------------------------------------------
// CORE IDENTITY
// ------------------------------------------------------------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  fullName      String
  phone         String?
  profileImage  String?
  role          Role          @default(USER)
  status        AccountStatus @default(PENDING)

  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  lastLoginAt   DateTime?

  // Financial balances (Backend Stage 4). These are ONLY ever mutated by
  // ledger.service.js from inside a database transaction alongside the
  // Transaction row that justifies the change — never written directly
  // by a controller, and never accepted from the client. See
  // docs: "NEVER trust financial values supplied by the frontend."
  cashbackBalance   Decimal @default(0) @db.Decimal(14, 2)
  commissionBalance Decimal @default(0) @db.Decimal(14, 2)
  rewardBalance     Decimal @default(0) @db.Decimal(14, 2)

  agent         Agent?
  orders        Order[]
  reviews       Review[]
  posts         CommunityPost[]
  notifications Notification[]

  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  referralAttribution      Referral?                @relation("ReferredUser")
  adminActivities          AdminActivity[]           @relation("AdminActor")

  // Courses & content (Backend Stage 3)
  coursesTaught   Course[]         @relation("CourseInstructor")
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  uploadedFiles   FileAsset[]      @relation("FileUploader")

  // Financial engine (Backend Stage 4)
  transactions    Transaction[]
  withdrawals     Withdrawal[]
  paystackRecipients PaystackRecipient[]
  rewards         Reward[]

  // Payments (Backend Stage 5)
  payments        Payment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

// Agent-specific data, linked 1:1 to a User with role AGENT.
// Commission/cashback calculations arrive in a later backend stage.
model Agent {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])

  // Human-facing unique agent identifier, e.g. "AGT-10001".
  agentId            String             @unique
  // Unique code used in referral links, e.g. "AGT10001".
  referralCode       String             @unique

  status             AccountStatus      @default(ACTIVE)

  successfulReferrals Int               @default(0)
  verificationStatus  VerificationStatus @default(NOT_VERIFIED)
  verifiedAt          DateTime?

  referrals  Referral[]
  orders     Order[]
  rewards    Reward[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("agents")
}

// ------------------------------------------------------------
// AUTHENTICATION TOKENS
// ------------------------------------------------------------

// One row per issued refresh token so it can be individually revoked
// (logout, password change, reuse detection). Only a hash of the token
// is ever stored — never the raw secret.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ------------------------------------------------------------
// COURSES & CONTENT (Backend Stage 3)
// ------------------------------------------------------------

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  image       String?
  status      CategoryStatus @default(ACTIVE)

  courses     Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// Financial calculations (cashback/commission/rewards) are NOT stored or
// computed here — see Backend Stage 4. price/currency are the single
// server-side source of truth for what a course costs; the client-supplied
// price is never trusted (see order.service.js).
model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  description      String?
  shortDescription String?
  thumbnail        String?
  coverImage       String?

  price            Decimal      @db.Decimal(12, 2)
  currency         String       @default("GHS")

  categoryId       String?
  category         Category?    @relation(fields: [categoryId], references: [id])

  instructorId     String?
  instructor       User?        @relation("CourseInstructor", fields: [instructorId], references: [id])

  status           CourseStatus @default(DRAFT)
  featured         Boolean      @default(false)
  publishedAt      DateTime?

  modules          Module[]
  orders           Order[]
  reviews          Review[]
  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  fileAssets       FileAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  title       String
  description String?
  // Explicit display order — never rely on DB insertion order.
  position    Int      @default(0)

  lessons     Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("modules")
}

// No quiz/assessment lesson types by design — see LessonType enum.
model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id])
  title       String
  description String?
  type        LessonType @default(TEXT)
  // Freeform content pointer: a video/audio/document URL, external link,
  // or plain text body, depending on `type`. Large binaries belong in
  // FileAsset + object storage, not here.
  content     String?
  position    Int        @default(0)
  // Duration in seconds, where applicable (video/audio).
  duration    Int?
  // Preview lessons are accessible without purchasing the course.
  isPreview   Boolean    @default(false)

  progress    LessonProgress[]
  fileAssets  FileAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("lessons")
}

// A user's access to a course, created once an Order for it is paid.
// One row per (user, course) — re-purchasing does not create a duplicate.
model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id])
  orderId        String?          @unique
  order          Order?           @relation(fields: [orderId], references: [id])

  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  lastAccessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

// Per-lesson completion tracking, rolled up into course-level progress
// (see progress.service.js). No quiz/assessment scoring — completion is
// a simple boolean.
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id])
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id])

  completed    Boolean   @default(false)
  completedAt  DateTime?
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("lesson_progress")
}

// Clean abstraction over a digital file so the system isn't locked to one
// storage provider. Large binaries are never stored in Postgres — this
// row only holds metadata + a storage reference (see fileAsset.service.js).
model FileAsset {
  id         String   @id @default(cuid())
  fileName   String
  fileType   String
  mimeType   String?
  fileSize   Int?
  // Object-storage key/path (provider-agnostic).
  storageKey String?
  // Public or signed URL, where applicable — never a raw storage credential.
  url        String?

  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id])
  lessonId   String?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id])

  uploadedBy String?
  uploader   User?    @relation("FileUploader", fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([lessonId])
  @@map("file_assets")
}

// ------------------------------------------------------------
// COMMERCE & FINANCE (structural only — see note at top of file)
// ------------------------------------------------------------

// Successful purchases are FINAL — no refunds, no cancellations once PAID.
// Enforced in the service layer (order.service.js); financial calculations
// (cashback/commission) are intentionally NOT computed here — Backend Stage 4.
model Order {
  id          String        @id @default(cuid())
  // Human-readable unique identifier, e.g. "ORD-20260822-000001".
  orderNumber String        @unique

  userId      String
  user        User          @relation(fields: [userId], references: [id])
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id])

  // Server-calculated at order creation from Course.price — the client
  // never determines this value. See order.service.js.
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("GHS")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  // Provider payment reference (e.g. Paystack transaction reference).
  // Real verification arrives in a later backend stage.
  paymentReference String?    @unique

  // Referral attribution preserved at purchase time, if any. Commission
  // calculation and Referral.status transition to SUCCESSFUL are handled
  // by a later backend stage — never here.
  agentId       String?
  agent         Agent?        @relation(fields: [agentId], references: [id])
  referralCode  String?

  enrollment  Enrollment?
  // Legacy 1:1 stub relation kept only for the (unused) `transaction`
  // field name from Stage 1 scaffolding. Backend Stage 4's financial
  // ledger deliberately does NOT use this — a paid order can generate
  // MULTIPLE ledger rows (COURSE_PURCHASE, CASHBACK, and sometimes
  // COMMISSION), which Transaction.referenceType/referenceId model
  // below, not a 1:1 FK. See Transaction model.
  transaction Transaction?
  // Set once this order causes a Referral to become SUCCESSFUL
  // (Backend Stage 4). At most one order can complete a given referral.
  referral    Referral?
  // Backend Stage 5: every Paystack payment ATTEMPT against this order
  // (there can be more than one — see Payment model / "Payment Retry").
  payments    Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@index([userId])
  @@index([courseId])
  @@index([agentId])
  @@index([status])
  @@map("orders")
}

// Immutable financial ledger (Backend Stage 4). Every balance-affecting
// (and some non-balance, e.g. COURSE_PURCHASE) financial event gets
// exactly one row here. Rows are NEVER updated or deleted by application
// code after creation — corrections happen via new rows (e.g.
// WITHDRAWAL_REVERSAL), never by mutating history.
//
// Idempotency: @@unique([type, referenceId]) guarantees a given event
// (e.g. "cashback for order X") can only ever be recorded once, even if
// the triggering webhook/handler runs twice concurrently.
model Transaction {
  id            String             @id @default(cuid())
  // Human-readable unique identifier, e.g. "TXN-20260822-000001".
  transactionId String             @unique

  userId        String
  user          User               @relation(fields: [userId], references: [id])

  type          TransactionType
  amount        Decimal            @db.Decimal(14, 2)
  currency      String             @default("GHS")
  status        TransactionStatus  @default(SUCCESSFUL)

  // Which of the three balances this event affects. Null for events that
  // don't touch a balance (e.g. COURSE_PURCHASE is a record of the sale,
  // not a balance credit/debit).
  balanceType   BalanceType?

  referenceType ReferenceType?
  referenceId   String?

  description   String?
  // Freeform structured context (e.g. { rate: 0.2 }) — never secrets.
  metadata      Json?

  // Legacy Stage 1 stub 1:1 relation — see Order.transaction comment.
  // Not used by Stage 4 logic (which reads referenceType/referenceId).
  orderId       String?            @unique
  order         Order?             @relation(fields: [orderId], references: [id])

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([type, referenceId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([balanceType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("transactions")
}

// Attribution record. Created either at registration time (a new user
// signs up with an Agent's referral code) or, failing that, resolved at
// purchase time from Order.agentId/referralCode (see
// referral.service.js#resolveReferralForOrder). Registration/attribution
// alone is NOT a successful referral — status only becomes SUCCESSFUL
// once a qualifying purchase (Backend Stage 4) confirms it, at which
// point Agent.successfulReferrals is incremented and verification is
// recalculated.
model Referral {
  id             String         @id @default(cuid())
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id])

  // The new user who registered with (or, failing that, checked out
  // with) the Agent's referral code. One user can be attributed to
  // exactly one referring Agent.
  referredUserId String         @unique
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id])

  referralCode   String
  status         ReferralStatus @default(REGISTERED)

  // The qualifying order that made this referral SUCCESSFUL. Null until
  // then. Unique — the same order can never complete two referrals.
  orderId        String?        @unique
  order          Order?         @relation(fields: [orderId], references: [id])
  successfulAt   DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([agentId])
  @@index([status])
  @@map("referrals")
}

// Referral milestone rewards (see config/rewardTiers.js for the
// configurable milestone -> amount table). One row per agent per
// milestone per period — @@unique below is the duplicate-protection
// mechanism required by the platform rules.
model Reward {
  id          String       @id @default(cuid())

  userId      String
  user        User         @relation(fields: [userId], references: [id])
  agentId     String
  agent       Agent        @relation(fields: [agentId], references: [id])

  type        RewardType   @default(REFERRAL_MILESTONE)
  milestone   Int
  amount      Decimal      @db.Decimal(14, 2)
  currency    String       @default("GHS")

  periodStart DateTime
  periodEnd   DateTime
  status      RewardStatus @default(SUCCESSFUL)

  // The ledger Transaction that credited rewardBalance for this reward.
  transactionId String?    @unique

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([agentId, milestone, periodStart])
  @@index([userId])
  @@index([agentId])
  @@map("rewards")
}

// A user's request to withdraw from one of their three balances.
// No minimum, no maximum — see withdrawal.service.js. The requested
// amount is debited from the user's balance atomically at request time
// (see createWithdrawal's conditional update), so it is immediately
// unavailable to a second concurrent request; if the withdrawal later
// fails/is rejected, a WITHDRAWAL_REVERSAL transaction credits it back.
model Withdrawal {
  id              String           @id @default(cuid())
  // Human-readable unique identifier, e.g. "WD-20260822-000001".
  withdrawalId    String           @unique

  userId          String
  user            User             @relation(fields: [userId], references: [id])

  // Gross amount requested by the user — this is what is deducted from
  // their balance at request time (unchanged from the pre-Phase-11
  // behavior) and what is restored in full on rejection/failure.
  amount          Decimal          @db.Decimal(14, 2)
  // 5% of `amount`, calculated server-side at request time and never
  // trusted from the client. Informational/accounting only — never
  // separately deducted from the user's balance (see withdrawal.service.js).
  fee             Decimal          @db.Decimal(14, 2) @default(0)
  // amount - fee. This is the exact figure sent to Paystack's Transfer
  // API — Paystack never sees or touches the gross amount or the fee.
  netAmount       Decimal          @db.Decimal(14, 2) @default(0)
  currency        String           @default("GHS")
  balanceType     BalanceType

  paymentMethod   String
  // Provider-specific payout details (e.g. mobile money number, bank
  // account). Never returned in full over the API — see
  // models/finance.mapper.js.
  paymentDetails  Json?

  status          WithdrawalStatus @default(PENDING)
  // The unique reference WE generate and send to Paystack's /transfer
  // call — this is what the transfer webhook uses to look the
  // withdrawal back up (see payment.service.js#handleTransferWebhookEvent).
  // Also used for the legacy admin-supplied manual reference, pre-Phase-11.
  reference       String?          @unique
  // Paystack's own transfer_code for this transfer attempt — needed to
  // query GET /transfer/:id_or_code for manual status verification.
  transferCode    String?
  // Paystack's reusable recipient_code for this payout destination —
  // see PaystackRecipient below, which is where reuse-detection actually
  // happens; this column is a denormalized copy for quick display.
  recipientCode   String?
  // Also used for a transfer-failure reason returned by Paystack, in
  // addition to its original admin-rejection-reason purpose.
  rejectionReason String?

  requestedAt     DateTime         @default(now())
  processedAt     DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([balanceType])
  @@index([createdAt])
  @@map("withdrawals")
}

// Reusable Paystack transfer recipients, so a user withdrawing to the same
// Mobile Money number / bank account repeatedly doesn't create a new
// recipient with Paystack every time (see "avoid unnecessary duplicate
// recipients", Phase 11 spec §5).
model PaystackRecipient {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  // "mobile_money" | "ghipss" (Paystack's Ghana recipient types).
  type           String
  // Paystack's bank/network code for this destination (fetched from the
  // real GET /bank endpoint at request time — never hardcoded/guessed).
  bankCode       String
  accountNumber  String
  accountName    String
  recipientCode  String   @unique

  createdAt      DateTime @default(now())

  @@unique([userId, type, bankCode, accountNumber])
  @@index([userId])
  @@map("paystack_recipients")
}

// ------------------------------------------------------------
// ENGAGEMENT
// ------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// One active review per user per course — a repeat submission updates the
// existing row instead of creating a duplicate (see review.service.js).
model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id])

  rating    Int
  title     String?
  comment   String?
  status    ReviewStatus @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("reviews")
}

model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("community_posts")
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  courseId  String

  issuedAt  DateTime @default(now())

  @@map("certificates")
}

// ------------------------------------------------------------
// ADMIN
// ------------------------------------------------------------

// Audit trail for admin actions (suspend/activate user or agent, etc.).
// Never stores passwords or tokens.
model AdminActivity {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminActor", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_activity")
}
