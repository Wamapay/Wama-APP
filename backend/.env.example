# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/platform_dev"

# --- JWT ---
# Generate strong random secrets, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Frontend / CORS ---
FRONTEND_URL="http://localhost:3000"
ADMIN_FRONTEND_URL="http://localhost:3001"
CORS_EXTRA_ORIGINS=""

# --- Paystack (Backend Stage 5) ---
# Use your Paystack TEST keys in development — never mix test and live
# credentials. Get these from Dashboard > Settings > API Keys & Webhooks.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_BASE_URL="https://api.paystack.co"
# Fully-qualified URL Paystack redirects the browser to after checkout.
# Must match the frontend's real callback route (see app.html's
# CheckoutCallback component / "/checkout/callback" hash route) —
# e.g. "https://yourapp.com/#/checkout/callback" in production.
# The backend never trusts this alone as proof of payment — see docs/API_STAGE5.md.
PAYSTACK_CALLBACK_URL="http://localhost:3000/#/checkout/callback"
# Optional additional shared secret if you front the webhook with your own
# proxy check. Paystack itself signs webhooks with PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_REQUEST_TIMEOUT_MS=15000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# --- Auth-specific rate limiting (login/register/forgot-password) ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Logging ---
LOG_LEVEL=info

# --- Dev-only routes (must be false/unset in production) ---
ENABLE_DEV_ROUTES=true

# --- Reward week boundary (Backend Stage 4) ---
# Minutes to shift the Monday-Sunday referral-milestone week window from
# UTC (e.g. -60 for GMT+1... i.e. use the POSITIVE offset for a timezone
# ahead of UTC, negative for one behind). Default 0 = UTC. See
# utils/weekBoundary.js.
REWARD_WEEK_UTC_OFFSET_MINUTES=0
